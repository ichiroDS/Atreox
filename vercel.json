{
  "buildCommand": "node scripts/prerender.mjs",
  "outputDirectory": ".",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/success",      "destination": "/success.html" },
    { "source": "/course",       "destination": "/course.html"  },
    { "source": "/functions",    "destination": "/index.html"   },
    { "source": "/pricing",      "destination": "/index.html"   },
    { "source": "/guides",       "destination": "/index.html"   },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" },
    { "source": "/privacy",      "destination": "/index.html"   },
    { "source": "/terms",        "destination": "/index.html"   }
  ]
}
