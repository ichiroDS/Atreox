{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/go/floppydata",
      "destination": "https://floppydata.com?ref=H9UGH5",
      "permanent": false
    },
    {
      "source": "/blog/telegram-session-killed-by-ip-change",
      "destination": "/guides/telegram-session-killed-by-ip-change",
      "permanent": true
    },
    {
      "source": "/blog/telegram-session-killed-by-ip-change.html",
      "destination": "/guides/telegram-session-killed-by-ip-change",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blog/category/:slug",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/blog/category/:slug.html",
      "destination": "/guides",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/functions",
      "destination": "/functions.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/tools/proxy-checker",
      "destination": "/tools/proxy-checker.html"
    },
    {
      "source": "/tools/account-checker",
      "destination": "/tools/account-checker.html"
    },
    {
      "source": "/referral-program",
      "destination": "/referral-program.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog/telegram-account-aging-claims-tested",
      "destination": "/blog/telegram-account-aging-claims-tested.html"
    }
  ],
  "headers": [
    {
      "source": "/public/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/public/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/public/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/public/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/public/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
