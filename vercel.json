{
  "buildCommand": "node scripts/build-app.mjs && node scripts/prerender.mjs",
  "outputDirectory": ".",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/functions",    "destination": "/index.html"   },
    { "source": "/pricing",      "destination": "/index.html"   },
    { "source": "/guides",       "destination": "/index.html"   },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" },
    { "source": "/referral-program", "destination": "/referral-program.html" },
    { "source": "/privacy",      "destination": "/index.html"   },
    { "source": "/terms",        "destination": "/index.html"   },
    { "source": "/refund",       "destination": "/index.html"   },
    { "source": "/contact",      "destination": "/index.html"   }
  ]
}
